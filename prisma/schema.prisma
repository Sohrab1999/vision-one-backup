// Prisma schema for the "Vision One" interactive web book.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// سؤالات آزمون استخراج‌شده از جزوه (گرامر و واژگان)
model Question {
  id          String   @id @default(cuid())
  /// شناسه جزوهٔ مالک سؤال — "vision-one" | "grade-7" | "grade-8" | "grade-9" | "grade-11" | "grade-12"
  book        String   @default("vision-one")
  /// "grammar" | "vocabulary"
  category    String
  /// 0 = جمع‌بندی, 1..4 = شماره درس
  lesson      Int
  /// محدوده سؤال مثل "درس اول" یا "جمع‌بندی درس ۱ تا ۴"
  scope       String
  /// متن سؤال انگلیسی
  text        String
  /// آرایه JSON چهار گزینه
  options     String
  /// اندیس گزینه صحیح (0-3)
  answer      Int
  /// سطح سؤال: "آموزشی" | "متوسط" | "استاندارد" | "کنکوری"
  level       String
  /// توضیح کوتاه اختیاری
  explanation String?
  createdAt   DateTime @default(now())

  @@index([category, lesson])
  @@index([book])
}

/// حساب کاربری — ورود با نام کاربری + کد ۴ رقمی (فاز ۱ نقشه راه جامع)
model User {
  id        String     @id @default(cuid())
  /// نام کاربری یکتا (لاتین یا فارسی، ۳ تا ۲۰ نویسه)
  username  String     @unique
  /// هش scrypt کد ۴ رقمی به شکل "salt:hash"
  pinHash   String
  /// پایه تحصیلی مثل "دهم" — اختیاری
  grade     String?
  /// آواتار ایموجی انتخابی
  avatar    String?
  createdAt DateTime   @default(now())

  progress Progress[]
  attempts Attempt[]
  reviewStates ReviewState[]
  wordNotes WordNote[]

  @@index([username])
}

/// اسنپ‌شات پیشرفت هر کاربر (کلیدهای visionone:* همگام‌شده از localStorage)
model Progress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// کلید کامل localStorage مثل "visionone:book:grade-11:learned"
  key    String
  /// مقدار متنی همان کلید
  value  String

  @@unique([userId, key])
  @@index([userId])
}

/// نتیجه یک آزمون کامل‌شده توسط کاربر
model Attempt {
  id        String   @id @default(cuid())
  /// شناسه جزوهٔ مالک آزمون — "vision-one" | "grade-7" | "grade-8" | "grade-9" | "grade-11" | "grade-12"
  book      String   @default("vision-one")
  /// "grammar" | "vocabulary" | "all"
  category  String
  lesson    Int
  total     Int
  correct   Int
  /// مدت آزمون به ثانیه
  duration  Int
  /// نام کاربر (اختیاری)
  name      String?
  /// جزئیات پاسخ‌ها به صورت JSON
  detail    String?
  /// کاربر وارد‌شده (اختیاری — حالت مهمان null)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([category])
  @@index([book])
  @@index([userId])
}

/// وضعیت مرور فاصله‌دار (SRS) هر کارت برای هر کاربر — فاز ۲ نقشه راه جامع
model ReviewState {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// شناسه جزوه — "vision-one" | "grade-7" | "grade-8" | "grade-9" | "grade-11" | "grade-12"
  book     String
  /// کلید کارت: واژه = متن خود واژه · فعل بی‌قاعده = "v:<base>"
  cardKey  String
  /// "word" | "verb"
  cardType String  @default("word")
  /// شماره درس (۰ = نامشخص)
  chapter  Int     @default(0)
  /// ضریب سهولت SM-2 (۱.۳ تا ۳.۵)
  ease     Float   @default(2.5)
  /// فاصلهٔ فعلی مرور به روز (اعشاری)
  interval Float   @default(0)
  reps     Int     @default(0)
  lapses   Int     @default(0)
  streak   Int     @default(0)
  /// سررسید مرور بعدی
  dueAt    DateTime @default(now())
  /// آخرین درجه: ۰=نمی‌دونم ۱=سخت ۲=بلد بودم
  lastGrade Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, book, cardKey])
  @@index([userId, dueAt])
  @@index([userId, book])
}

/// کلاس مجازی — فاز ۹ نقشه راه جامع
model Classroom {
  id          String   @id @default(cuid())
  /// کد ۶ رقمی یکتا برای پیوستن
  code        String   @unique
  name        String
  teacherName String
  /// uuid دستگاه معلم — برای احراز دسترسی معلم بدون لاگین
  teacherKey  String
  book        String   @default("vision-one")
  createdAt   DateTime @default(now())
  members     ClassMember[]
  assignments Assignment[]
  quizzes     LiveQuiz[]
  notifications Notification[]

  @@index([teacherKey])
}

/// عضو کلاس — شناسه با uuid دستگاه دانش‌آموز (بدون ایمیل)
model ClassMember {
  id           String   @id @default(cuid())
  classroomId  String
  studentKey   String
  displayName  String
  joinedAt     DateTime @default(now())
  lastActiveAt DateTime @default(now())
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentKey])
  @@index([classroomId])
}

/// تکلیف کلاس
model Assignment {
  id            String    @id @default(cuid())
  classroomId   String
  title         String
  /// "review" (مرور واژگان درس) | "quiz" (آزمون N سؤالی)
  kind          String    @default("review")
  lesson        Int?
  questionCount Int?
  dueAt         DateTime?
  createdAt     DateTime  @default(now())
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  dones         AssignmentDone[]

  @@index([classroomId])
}

/// انجام‌شدن تکلیف توسط یک دانش‌آموز
model AssignmentDone {
  id           String   @id @default(cuid())
  assignmentId String
  studentKey   String
  score        Int?
  doneAt       DateTime @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentKey])
  @@index([assignmentId])
}

/// اعلان داخل اپ — بدون پیامک/ایمیل
model Notification {
  id          String    @id @default(cuid())
  classroomId String
  /// کلید گیرنده یا "*" برای همهٔ اعضا
  targetKey   String    @default("*")
  text        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, targetKey])
}

/// آزمون زندهٔ کلاسی
model LiveQuiz {
  id           String    @id @default(cuid())
  classroomId  String
  /// "active" | "finished"
  status       String    @default("active")
  /// آرایهٔ JSON شناسه سؤال‌ها از مدل Question
  questionIds  String
  currentIndex Int       @default(0)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  answers      LiveAnswer[]

  @@index([classroomId])
}

/// پاسخ لحظه‌ای دانش‌آموز در آزمون زنده
model LiveAnswer {
  id          String   @id @default(cuid())
  quizId      String
  studentKey  String
  displayName String
  index       Int
  correct     Boolean
  ms          Int      @default(0)
  /// گزینهٔ انتخابی دانش‌آموز (۰..۳) — برای «پاسخ قبلی من» در GET زنده
  choice      Int      @default(-1)
  /// متن سؤال — برای «واژه‌های/سؤال‌های مشکل‌دار کلاس» در داشبورد معلم
  content     String   @default("")
  createdAt   DateTime @default(now())
  quiz        LiveQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentKey, index])
  @@index([quizId])
}

/// یادداشت شخصی کاربر روی یک واژه — فاز ۱۰ نقشه راه جامع
model WordNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// شناسه جزوه — "vision-one" | "grade-7" | "grade-8" | "grade-9" | "grade-11" | "grade-12"
  book      String
  /// متن واژه انگلیسی (کلید یادداشت)
  word      String
  /// یادداشت شخصی کاربر (فارسی/انگلیسی، سقف ۵۰۰ نویسه)
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, book, word])
  @@index([userId, book])
}
