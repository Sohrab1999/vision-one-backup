        "text": "50.1"
      },
      {
        "y": 71.5,
        "x0": 116.2,
        "x1": 397.3,
        "tag": "main",
        "text": "Match the two parts of the collocations from the opposite page."
      },
      {
        "y": 88,
        "x0": 116.2,
        "x1": 296.9,
        "tag": "main",
        "text": "1 air a groups"
      },
      {
        "y": 100,
