        "tag": "main",
        "text": "have a good working relationship2"
      },
      {
        "y": 125.5,
        "x0": 335.3,
        "x1": 503.1,
        "tag": "dict",
        "entryNumber": 4,
        "text": "4 more formal equivalent of opposite number"
      },
      {
        "y": 129.2,
        "x0": 182.9,
        "x1": 282.4,
        "tag": "main",
        "text": "and there’s a lot of day-to-"
      },
      {
