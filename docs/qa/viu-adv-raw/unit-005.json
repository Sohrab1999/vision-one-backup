      {
        "y": 149.5,
        "x0": 335.3,
        "x1": 506.8,
        "tag": "dict",
        "entryNumber": 6,
        "text": "6 make decisions without being told what to do"
      },
      {
        "y": 152.4,
        "x0": 107.1,
        "x1": 302.6,
        "tag": "main",
        "text": "counterpart4 like Philip in another branch is a great"
