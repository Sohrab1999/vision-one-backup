        "x1": 224.2,
        "tag": "main",
        "text": "Answer these questions."
      },
      {
        "y": 88,
        "x0": 116.2,
        "x1": 328.8,
        "tag": "main",
        "text": "1 What do you mean if you call someone ‘scruffy’?"
      },
      {
        "y": 100,
        "x0": 116.2,
        "x1": 377,
        "tag": "main",
        "text": "2 What is the dress code in a workplace you are familiar with?"
      },
      {
        "y": 112,
        "x0": 116.2,
        "x1": 384.2,
        "tag": "main",
        "text": "3 What kinds of clothes are not appropriate for a job interview?"
      },
      {
        "y": 124,
        "x0": 116.2,
        "x1": 505.5,
        "tag": "main",
        "text": "4 What might be appropriate clothes to wear for a job interview for a man and for a woman?"
      },
      {
        "y": 136,
        "x0": 116.2,
        "x1": 248.3,
        "tag": "main",
        "text": "5 What is your favourite outfit?"
      },
      {
        "y": 148,
        "x0": 116.2,
        "x1": 356.9,
        "tag": "main",
        "text": "6 And what accessories would be required for this outfit?"
      },
      {
        "y": 160,
        "x0": 116.2,
        "x1": 382.9,
        "tag": "main",
        "text": "7 What would you put on if you had a dress-down day at work?"
      },
      {
