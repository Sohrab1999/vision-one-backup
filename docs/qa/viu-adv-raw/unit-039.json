        "x1": 333,
        "tag": "main",
        "text": "5 The event when a king or queen receives a crown"
      },
      {
        "y": 148,
        "x0": 116.2,
        "x1": 323.6,
        "tag": "main",
        "text": "6 Several different countries ruled by one person"
      },
      {
        "y": 160,
        "x0": 116.2,
        "x1": 399.4,
        "tag": "main",
        "text": "7 A metaphorical expression meaning ‘the beginning’ of something"
      },
