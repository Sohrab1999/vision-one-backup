        "y": 71.5,
        "x0": 116.2,
        "x1": 377.3,
        "tag": "main",
        "text": "Which words on the opposite page are these definitions of?"
      },
      {
        "y": 88,
        "x0": 116.2,
        "x1": 339.5,
        "tag": "main",
        "text": "1 The period during which someone is king or queen"
      },
      {
        "y": 100,
        "x0": 116.2,
        "x1": 322.8,
        "tag": "main",
        "text": "2 A family that rules during different generations"
      },
      {
        "y": 112,
        "x0": 116.2,
        "x1": 449.6,
        "tag": "main",
        "text": "3 Someone who is legally entitled to take power or control when someone dies"
      },
      {
        "y": 124,
        "x0": 116.2,
        "x1": 219.8,
        "tag": "main",
        "text": "4 A text written by hand"
